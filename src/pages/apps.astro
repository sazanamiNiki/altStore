---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';

const siteUrl = 'https://altstore-jp.bunchoniki.com';

// ビルド時にアプリデータを取得（JSON-LDスキーマ用、画面表示はJS側で行う）
interface AppData {
  name: string;
  iconURL: string;
  developerName: string;
  downloadURL: string;
  category: string;
  subtitle?: string;
  distributionInfo?: { category: string };
}

let allApps: AppData[] = [];
try {
  const response = await fetch(
    'https://script.google.com/macros/s/AKfycbxcaYOnyNaovd0ERTnVKKRxZP0x4eWSftKk-mMVCXZrbuQDw8e-aPN9sj4dSDPoGYeBsg/exec',
    { signal: AbortSignal.timeout(10000) }
  );
  const data = await response.json();
  allApps = data.apps || [];
} catch (e) {
  console.warn('[Build] Apps fetch failed:', e);
}

// BreadcrumbListスキーマ
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "アプリカタログ", "item": `${siteUrl}/apps/` },
  ]
};

// SoftwareApplication ItemListスキーマ
const appListSchema = allApps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "厳選アプリカタログ",
  "numberOfItems": allApps.length,
  "itemListElement": allApps.map((app, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "SoftwareApplication",
      "name": app.name,
      "applicationCategory": app.category,
      "operatingSystem": "iOS",
      "author": { "@type": "Person", "name": app.developerName },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" }
    }
  }))
} : null;
---

<BaseLayout
  title="アプリカタログ"
  description="iPhone向けサイドローディングアプリの厳選カタログ。Delta・UTM・SideStoreなど、安全性を確認済みのアプリをカテゴリー別に掲載。App Store配信・IPA配布の配布方法でフィルター可能。"
>
  <Fragment slot="schema">
    <Schema data={breadcrumbSchema} />
    {appListSchema && <Schema data={appListSchema} />}
  </Fragment>

  <main class="max-w-7xl mx-auto px-4 py-12">
    <div class="mb-8 sm:mb-12">
      <h1 class="text-2xl sm:text-4xl font-bold mb-2 sm:mb-4">アプリカタログ</h1>
      <p class="text-gray-600 mb-3">iPhoneで使える厳選サイドローディングアプリを掲載しています。すべて公式ソースから取得し、安全性を確認済みです。</p>
      <p class="text-sm text-gray-500">App Storeから直接入手できるアプリと、AltStore/SideStore経由でインストールするIPAアプリの両方を扱っています。</p>
    </div>

    <details class="bg-white rounded-lg border border-gray-200 sm:border-2 mb-6 sm:mb-8 group" id="filter-details">
      <summary class="flex items-center justify-between p-4 sm:p-6 cursor-pointer sm:cursor-default list-none [&::-webkit-details-marker]:hidden">
        <div class="flex items-center gap-2">
          <span class="material-symbols-outlined text-gray-500 text-xl">filter_list</span>
          <span class="font-medium text-gray-700">フィルター・検索</span>
          <span id="active-filter-count" class="hidden bg-sky-500 text-white text-xs font-bold px-2 py-0.5 rounded-full"></span>
        </div>
        <span class="material-symbols-outlined text-gray-400 transition-transform group-open:rotate-180 sm:hidden">expand_more</span>
      </summary>
      <div class="px-4 pb-4 sm:px-6 sm:pb-6 sm:pt-0">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 mb-4 sm:mb-6">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">アプリ名や作った人で探す</label>
            <input
              type="text"
              id="search-input"
              placeholder="Delta、UTM、Sidestoreなど..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sky-500 focus:border-transparent"
            />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">カテゴリーで選ぶ</label>
            <select id="category-select" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sky-500 focus:border-transparent">
              <option value="">すべてのカテゴリー</option>
            </select>
          </div>
        </div>
        <div class="mb-4 sm:mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">配布方法</label>
          <select id="distribution-filter" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-sky-500 focus:border-transparent">
            <option value="">すべて表示</option>
            <option value="official">App Store配信</option>
            <option value="sideload">IPA配布（7日署名）</option>
          </select>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 sm:gap-4">
          <button id="notarized-filter" class="btn-secondary icon-with-text">
            <span class="material-symbols-outlined check-icon">check_circle</span>
            <span>安心マーク付きのみ</span>
          </button>
          <button id="reset-filter" class="btn-secondary">条件をリセット</button>
        </div>
      </div>
    </details>

    <div id="app-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {allApps.length > 0 ? allApps.map(app => (
        <div class="app-card-ssr bg-white rounded-xl p-4 border border-gray-200">
          <div class="flex items-start gap-3">
            <img src={app.iconURL} alt={app.name} width="60" height="60" loading="lazy" class="w-14 h-14 rounded-[22%] border border-gray-100 shadow-sm" />
            <div class="flex-1 min-w-0">
              <h3 class="font-bold text-base text-gray-900 line-clamp-1">{app.name}</h3>
              <p class="text-sm text-gray-500">{app.developerName}</p>
              <div class="flex items-center gap-1 mt-1">
                <span class="inline-block text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-md">{app.category}</span>
                {(app.distributionInfo?.category || 'sideload') === 'official'
                  ? <span class="inline-block text-xs bg-green-100 text-green-700 px-2 py-0.5 rounded-md">App Store</span>
                  : <span class="inline-block text-xs bg-yellow-100 text-yellow-700 px-2 py-0.5 rounded-md">IPA配布</span>
                }
              </div>
            </div>
          </div>
        </div>
      )) : (
        <div class="col-span-full text-center py-8">
          <p class="text-gray-500">アプリを読み込み中です</p>
        </div>
      )}
    </div>

    <div id="modal-container"></div>

  </main>

  <!-- app-catalog.js はPublicから参照（Google Sheets API連携） -->
  <script src="/assets/js/app-catalog.js" defer is:raw></script>

  <!-- sm以上ではフィルターを常時展開 -->
  <style>
    @media (min-width: 640px) {
      #filter-details {
        pointer-events: auto;
      }
      #filter-details:not([open]) {
        /* sm以上では常に開いた状態にする */
      }
    }
  </style>
  <script is:inline>
    // sm以上ではフィルターを常時展開、モバイルでは閉じた状態で開始
    (function() {
      const details = document.getElementById('filter-details');
      if (!details) return;
      function updateOpen() {
        if (window.innerWidth >= 640) {
          details.setAttribute('open', '');
        }
      }
      updateOpen();
      window.addEventListener('resize', updateOpen);
    })();
  </script>
</BaseLayout>
