---
import BaseLayout from '../layouts/BaseLayout.astro';
import Schema from '../components/Schema.astro';
const base = import.meta.env.BASE_URL;

// ビルド時にアプリデータを取得（SSR: Googlebotが読める静的HTMLを生成）
interface AppData {
  name: string;
  iconURL: string;
  developerName: string;
  downloadURL: string;
  category: string;
  distributionInfo?: { category: string };
}

let featuredApps: AppData[] = [];
try {
  const response = await fetch(
    'https://script.google.com/macros/s/AKfycbxcaYOnyNaovd0ERTnVKKRxZP0x4eWSftKk-mMVCXZrbuQDw8e-aPN9sj4dSDPoGYeBsg/exec',
    { signal: AbortSignal.timeout(10000) }
  );
  const data = await response.json();
  featuredApps = (data.apps || []).slice(0, 3);
} catch (e) {
  console.warn('[Build] Featured apps fetch failed:', e);
}

// FAQ data（レンダリングとFAQPageスキーマ両方で使用）
const faqItems = [
  {
    q: 'Q. サイドローディングって危なくない？',
    a: '大丈夫です。このサイトで紹介しているアプリは、開発元がはっきりしている公式アプリのみを扱っています。具体的には、オープンソースで透明性が確保されているエミュレータや、Appleの公証を受けたクリエイターアプリなど、それぞれのアプリの性質に合わせた安全確認を行っています。',
    tip: 'このサイト以外から野良アプリを入れる時は注意してください。信頼できるリポジトリからインストールすることが何より大切です。',
  },
  {
    q: 'Q. AltStore PALってどんなアプリ？',
    a: '2025年12月18日のスマートフォン新法（MSCA）施行により、日本でも利用可能になった<strong>代替アプリマーケットプレイス</strong>です。iOS 26.2以降のiPhoneなら、Safariからそのままインストールできます。従来のAltStore Classicと違って<strong>PC不要・USBケーブル不要・7日ごとの署名更新も不要</strong>なので、一般ユーザーにとって圧倒的に使いやすい方法です。Epic Games MegaGrantの支援により完全無料で利用できます。',
    tip: `詳しい始め方：「<a href="${base}articles/install-app-step-by-step/" class="font-bold underline">アプリをインストールする方法</a>」で画像付きで解説しています。`,
  },
  {
    q: 'Q. 「7日署名」って何？PALなら本当に制限なし？',
    a: '従来のAltStore Classicは、無料のApple IDで個人開発者向けの署名をする仕組みを使っているため、7日ごとに「署名」という許可証を更新する必要がありました。一方<strong>AltStore PAL（代替マーケットプレイス）</strong>は、スマホ新法で認められた正規の配布ルートを使うため、この7日制限が<strong>完全に撤廃</strong>されています。インストールしたらずっと使い続けられます。',
    tip: 'iOS 26.2以降をお使いなら、7日制限のないAltStore PALが最もおすすめです。',
  },
  {
    q: 'Q. ここのアプリって本当に安全？',
    a: 'はい、安全です。このサイトで紹介しているアプリは、すべて開発者の公式リポジトリから直接データを取得しており、改ざんのリスクがありません。エミュレータ（Delta、UTMなど）はオープンソースで誰でもコードを確認でき、透明性が確保されています。クリエイターアプリについては、Appleの公証を受けたものを扱います。',
    tip: '開発元がはっきりしており、公式ソースから取得しているため、出どころ不明な野良アプリとは根本的に違います。ただ、他のサイトから入れるときは注意してください。',
  },
];

const siteUrl = 'https://altstore-jp.bunchoniki.com';

// 最新情報データ
const recentUpdates = [
  { date: '2026-04-11', title: 'AltStore PAL完全ガイドを公開', href: `${base}articles/altstore-pal-guide/` },
  { date: '2026-04-11', title: 'AltStore PAL対応アプリ一覧を公開', href: `${base}articles/altstore-pal-apps/` },
  { date: '2026-04-11', title: '代替マーケットプレイスとは？を公開', href: `${base}articles/alternative-marketplace/` },
  { date: '2026-03-23', title: 'Delta無料ゲーム特集にカスタマイズガイドを追加', href: `${base}articles/free-games-for-delta/` },
];

// FAQPageスキーマ
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqItems.map(item => ({
    "@type": "Question",
    "name": item.q.replace(/^Q\.\s*/, ''),
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};

// BreadcrumbListスキーマ
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": siteUrl }
  ]
};

// ItemListスキーマ（記事一覧）
const articleListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "サイドローディング解説記事",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "AltStore PAL完全ガイド", "url": `${siteUrl}/articles/altstore-pal-guide/` },
    { "@type": "ListItem", "position": 2, "name": "AltStore PAL対応アプリ一覧", "url": `${siteUrl}/articles/altstore-pal-apps/` },
    { "@type": "ListItem", "position": 3, "name": "代替マーケットプレイスとは？", "url": `${siteUrl}/articles/alternative-marketplace/` },
    { "@type": "ListItem", "position": 4, "name": "iPhoneのサイドローディングとは？", "url": `${siteUrl}/articles/what-is-sideloading/` },
    { "@type": "ListItem", "position": 5, "name": "AltStoreの使い方", "url": `${siteUrl}/articles/how-to-use-altstore/` },
    { "@type": "ListItem", "position": 6, "name": "アプリをインストールする方法", "url": `${siteUrl}/articles/install-app-step-by-step/` },
    { "@type": "ListItem", "position": 7, "name": "野良アプリの安全ガイド", "url": `${siteUrl}/articles/safety-guide/` },
    { "@type": "ListItem", "position": 8, "name": "Delta/UTM SE 完全ガイド", "url": `${siteUrl}/articles/delta-utm-guide/` },
    { "@type": "ListItem", "position": 9, "name": "エミュレータは違法？著作権と正しい遊び方", "url": `${siteUrl}/articles/emulator-legal/` },
    { "@type": "ListItem", "position": 10, "name": "手数料30%カットの衝撃", "url": `${siteUrl}/articles/commission-cut/` },
  ]
};

// SoftwareApplicationスキーマ（SSR済みアプリ）
const appListSchema = featuredApps.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "おすすめアプリ",
  "itemListElement": featuredApps.map((app, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "SoftwareApplication",
      "name": app.name,
      "applicationCategory": app.category,
      "operatingSystem": "iOS",
      "author": { "@type": "Person", "name": app.developerName },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "JPY" }
    }
  }))
} : null;
---

<BaseLayout
  title="サイドローディング総合情報 - 厳選アプリカタログ"
  description="日本でAltStore PALが無料で使えるようになりました（iOS 26.2以降・PC不要）。AltStore PALの始め方、Delta・UTMなどの厳選アプリ紹介、安全ガイドを日本語で提供するサイドローディング総合情報サイト。"
>
  <Schema slot="schema" data={faqSchema} />
  <Schema slot="schema" data={breadcrumbSchema} />
  <Schema slot="schema" data={articleListSchema} />
  {appListSchema && <Schema slot="schema" data={appListSchema} />}

  <main>
    <!-- ヒーローセクション -->
<section class="bg-white py-8 lg:py-24">
  <div class="max-w-6xl mx-auto px-6">

    <div class="grid gap-6 sm:gap-8 lg:grid-cols-2 items-center">
      <div class="flex flex-col justify-center">
        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full w-fit mb-5">
          <span class="material-symbols-outlined text-[14px] leading-none">new_releases</span>
          日本で無料利用可能（iOS 26.2以降）
        </span>

        <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight tracking-tight text-gray-900">
          iPhoneを、<br>
          <span class="text-blue-600">もっと自由に。</span>
        </h1>

        <p class="mt-5 text-gray-600 leading-relaxed max-w-md">
          <strong class="text-gray-900">AltStore PAL</strong>が日本でついに無料で使えるようになりました。<br />
          <strong class="text-blue-600">PC不要・7日制限なし</strong>で、Safariからそのままインストール。初心者でも安心の日本語ガイド付き。
        </p>

        <div class="mt-6 sm:mt-8 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-5">
          <a href={`${base}articles/install-app-step-by-step/`}
            class="inline-flex items-center justify-center px-6 py-3 bg-blue-600 text-white rounded-lg font-medium shadow hover:bg-blue-700 transition">
            AltStore PALで始める →
          </a>

          <a href={`${base}apps`}
            class="inline-flex items-center justify-center text-sm text-gray-600 hover:text-blue-600 hover:underline">
            アプリカタログを見る
          </a>
        </div>
      </div>

      <!-- image -->
      <div class="flex justify-center">
        <div class="w-28 sm:w-36 lg:w-52 rounded-2xl shadow-lg overflow-hidden border-4 border-gray-900 bg-gradient-to-br from-blue-500 to-purple-600">
          <!-- 正方形に変更 -->
          <div class="aspect-square flex flex-col items-center justify-center text-white p-3 sm:p-6">
            <img
              src={`${base}assets/img/logo.png`}
              alt="bunchoniki Store ロゴ"
              width="80"
              height="80"
              class="w-1/2 opacity-95 mb-2 sm:mb-3"
            />
            <p class="text-xs sm:text-base font-bold leading-tight text-center">
              bunchoniki Store
            </p>
            <p class="text-[10px] sm:text-xs opacity-80 mt-0.5 sm:mt-1">
              Safe & Secure
            </p>
          </div>
        </div>
      </div>

    </div>

    <!-- feature cards -->
    <div class="mt-6 sm:mt-8 grid gap-3 sm:gap-4 sm:grid-cols-3">
      <div class="bg-white border border-gray-200 p-3 sm:p-4 rounded-xl">
        <div class="flex items-center gap-2 mb-1">
          <span class="material-symbols-outlined text-blue-600 text-[20px]">laptop_mac</span>
          <h3 class="font-semibold text-sm">PC不要</h3>
        </div>
        <p class="text-xs text-gray-600">Safariからそのままインストール。</p>
      </div>
      <div class="bg-white border border-gray-200 p-3 sm:p-4 rounded-xl">
        <div class="flex items-center gap-2 mb-1">
          <span class="material-symbols-outlined text-blue-600 text-[20px]">all_inclusive</span>
          <h3 class="font-semibold text-sm">7日制限なし</h3>
        </div>
        <p class="text-xs text-gray-600">代替マーケットプレイスで署名切れから解放。</p>
      </div>
      <div class="bg-white border border-gray-200 p-3 sm:p-4 rounded-xl">
        <div class="flex items-center gap-2 mb-1">
          <span class="material-symbols-outlined text-blue-600 text-[20px]">translate</span>
          <h3 class="font-semibold text-sm">日本語で解説</h3>
        </div>
        <p class="text-xs text-gray-600">初心者向けのステップバイステップガイド。</p>
      </div>
    </div>

  </div>
</section>


    <!-- 特徴セクション -->
    <section class="py-12 sm:py-14 lg:py-16 px-4 bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-3 sm:mb-4 text-gray-900">当サイトの特徴</h2>
        <p class="text-sm sm:text-base text-gray-600 text-center max-w-2xl mx-auto mb-8 sm:mb-12 leading-relaxed">
          サイドローディングに関する情報は英語が中心で、安全性の判断も難しいのが現状です。当サイトでは、掲載するアプリの安全性を独自に検証し、初心者でも迷わず使える日本語ガイドを提供しています。
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          <a href={`${base}articles/safety-guide/`} class="bg-white rounded-xl p-5 sm:p-8 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all block">
            <div class="mb-4">
              <span class="material-symbols-outlined feature-icon">verified</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-gray-900">ダブルチェック体制</h3>
            <p class="text-sm sm:text-base text-gray-700 leading-relaxed">アプリの性質に合わせて「オープンソースによる透明性」または「Appleによる公証」のいずれかを確認済み。根拠のない危険な野良アプリは一切扱いません。</p>
          </a>
          <a href={`${base}articles/delta-utm-guide/`} class="bg-white rounded-xl p-5 sm:p-8 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all block">
            <div class="mb-4">
              <span class="material-symbols-outlined feature-icon">sports_esports</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-gray-900">iPhoneでレトロゲーム</h3>
            <p class="text-sm sm:text-base text-gray-700 leading-relaxed">Deltaエミュレータを使えば、iPhoneでゲームボーイやファミコンのゲームが遊べます。App Storeから無料でダウンロードでき、導入方法や無料ゲームの入手先まで詳しく紹介しています。</p>
          </a>
          <a href={`${base}articles/what-is-sideloading/`} class="bg-white rounded-xl p-5 sm:p-8 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all block">
            <div class="mb-4">
              <span class="material-symbols-outlined feature-icon">menu_book</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-gray-900">丁寧な解説</h3>
            <p class="text-sm sm:text-base text-gray-700 leading-relaxed">2025年12月施行のスマートフォン特定ソフトウェア競争促進法（新法）への対応状況や、サイドローディングの基礎知識を図解付きで分かりやすく説明しています。</p>
          </a>
          <a href={`${base}articles/`} class="bg-white rounded-xl p-5 sm:p-8 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all block">
            <div class="mb-4">
              <span class="material-symbols-outlined feature-icon">language</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold mb-2 text-gray-900">日本語対応</h3>
            <p class="text-sm sm:text-base text-gray-700 leading-relaxed">AltStore PALやDeltaの公式ドキュメントは英語のみ。当サイトではセットアップ手順から法的な注意点まで、すべて日本語で解説しています。</p>
          </a>
        </div>
      </div>
    </section>

    <!-- AltStore PAL を推すセクション -->
    <section class="py-10 sm:py-14 px-4 bg-white border-t border-gray-200">
      <div class="max-w-6xl mx-auto">

        <div class="text-center mb-6 sm:mb-8">
          <span class="inline-flex items-center gap-1 text-xs font-semibold bg-indigo-100 text-indigo-700 px-3 py-1 rounded-full mb-3">
            <span class="material-symbols-outlined text-[14px] leading-none">new_releases</span>
            2025年12月18日〜 日本対応
          </span>
          <h2 class="text-xl sm:text-2xl font-bold mb-2 text-gray-900">
            いま選ぶなら <span class="text-indigo-600">AltStore PAL</span>
          </h2>
          <p class="text-sm sm:text-base text-gray-600 max-w-2xl mx-auto leading-relaxed">
            iOS 26.2以降、日本でも代替アプリマーケットプレイス版の<strong>AltStore PAL</strong>が無料で使えるようになりました。Safariからインストールするだけで、<strong>PC不要・7日制限なし</strong>。従来のセットアップ作業はもう必要ありません。
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">

          <!-- AltStore PAL（推奨） -->
          <a href={`${base}articles/install-app-step-by-step/`} class="relative bg-gradient-to-br from-indigo-50 to-blue-50 rounded-xl p-5 sm:p-6 border-2 border-indigo-300 hover:shadow-lg hover:border-indigo-400 transition-all block">
            <span class="absolute -top-3 left-5 inline-block bg-indigo-600 text-white text-xs font-bold px-3 py-1 rounded-full">おすすめ</span>
            <div class="flex items-center gap-2 mb-3 mt-1">
              <span class="material-symbols-outlined text-indigo-600">storefront</span>
              <h3 class="text-lg font-semibold text-gray-900">AltStore PAL</h3>
              <span class="text-xs text-gray-500 ml-auto">代替マーケットプレイス</span>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed mb-3">iOS 26.2以降の日本向け最新ルート。Safariから直接インストールできて、一般ユーザーにとって最もハードルが低い方法です。</p>
            <ul class="text-sm text-gray-700 space-y-1.5">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-green-600 text-base">check_circle</span><strong>PC・USBケーブル不要</strong></li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-green-600 text-base">check_circle</span><strong>7日ごとの署名更新が不要</strong></li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-green-600 text-base">check_circle</span>完全無料（2025年12月18日〜）</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-green-600 text-base">check_circle</span>自動更新対応</li>
            </ul>
            <span class="inline-block mt-4 text-sm font-semibold text-indigo-600">インストール手順を見る →</span>
          </a>

          <!-- AltStore Classic / SideStore（上級者向け） -->
          <a href={`${base}articles/altstore-complete-guide/`} class="bg-white rounded-xl p-5 sm:p-6 border border-gray-200 hover:shadow-md hover:border-gray-300 transition-all block">
            <div class="flex items-center gap-2 mb-3">
              <span class="material-symbols-outlined text-gray-500">build</span>
              <h3 class="text-lg font-semibold text-gray-900">AltStore Classic / SideStore</h3>
              <span class="text-xs text-gray-500 ml-auto">従来型</span>
            </div>
            <p class="text-sm text-gray-700 leading-relaxed mb-3">PCを使う従来ルート。iOS 26.2未満の端末を使っている方や、PAL非対応のアプリを入れたい方向けです。</p>
            <ul class="text-sm text-gray-600 space-y-1.5">
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gray-400 text-base">info</span><strong>Classic：</strong>毎回PC接続が必要</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gray-400 text-base">info</span><strong>SideStore：</strong>初回のみPC必要、以降はWi-Fiで自動更新</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gray-400 text-base">info</span>7日ごとの署名更新が必要</li>
              <li class="flex items-center gap-1.5"><span class="material-symbols-outlined text-gray-400 text-base">info</span>無料Apple IDで署名してインストール</li>
            </ul>
            <span class="inline-block mt-4 text-sm font-semibold text-gray-700">完全ガイドを見る →</span>
          </a>

        </div>
      </div>
    </section>

    <!-- 人気アプリ（ビルド時SSR） -->
    <section class="py-12 sm:py-14 lg:py-16 bg-slate-50">
      <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl sm:text-3xl font-bold text-center mb-8 sm:mb-12 text-gray-900 px-4">人気のアプリ</h2>

        {featuredApps.length > 0 && (
          <Fragment>
            <!-- モバイル: スライドショー -->
            <div id="slideshow-container" class="md:hidden relative px-4">
              <div class="relative overflow-hidden">
                <div id="featured-apps-mobile" class="flex transition-transform duration-500 ease-out">
                  {featuredApps.map((app) => (
                    <div class="app-card flex flex-col flex-shrink-0 w-full max-w-md mx-auto">
                      <div class="flex items-start gap-3 sm:gap-4">
                        <img src={app.iconURL} alt={app.name} width="80" height="80" loading="lazy" class="w-14 h-14 sm:w-20 sm:h-20 rounded-[22%] border border-gray-100 shadow-sm flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                          <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                              <h3 class="font-bold text-base sm:text-lg text-gray-900 leading-tight line-clamp-1">{app.name}</h3>
                              <p class="text-sm text-gray-500 mb-2">{app.developerName}</p>
                            </div>
                            <a href={app.downloadURL} class="flex-shrink-0 bg-[#007AFF] text-white font-bold text-xs sm:text-sm px-3 sm:px-5 py-1.5 sm:py-2 rounded-full text-center hover:bg-blue-600 transition shadow-sm whitespace-nowrap" download>入手</a>
                          </div>
                          <div class="flex flex-wrap items-center gap-1">
                            <span class="inline-block bg-gray-100 text-gray-500 text-[10px] px-2 py-0.5 rounded-md">{app.category}</span>
                            {(app.distributionInfo?.category || 'sideload') === 'official'
                              ? <span class="inline-block bg-green-100 text-green-700 text-[10px] px-2 py-0.5 rounded-md ml-1">App Store配信</span>
                              : <span class="inline-block bg-yellow-100 text-yellow-700 text-[10px] px-2 py-0.5 rounded-md ml-1">IPA配布</span>
                            }
                          </div>
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
