---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Schema from '../../components/Schema.astro';
const base = import.meta.env.BASE_URL;
const siteUrl = 'https://altstore-jp.bunchoniki.com';

const categories = [
  {
    label: 'アプリ・ガイド',
    articles: [
      { href: '/articles/top3-apps-2026/', title: '神アプリ3選', desc: '2026最新の厳選アプリTOP3', tag: '人気', tagColor: 'text-red-600 bg-red-50' },
      { href: '/articles/altstore-pal-apps/', title: 'PALで遊べるアプリ一覧', desc: 'Delta・フォートナイト・UTMフル版など日本で入手できる主要アプリ', tag: 'ガイド', tagColor: 'text-indigo-600 bg-indigo-50' },
      { href: '/articles/utm-guide/', title: 'UTM SE 完全ガイド', desc: 'iPhone/iPadでWindows/Linuxを動かす方法', tag: 'ガイド', tagColor: 'text-indigo-600 bg-indigo-50' },
      { href: '/articles/sidestore-guide/', title: 'SideStore', desc: 'PC不要でアプリ管理する日本語ガイド', tag: 'ガイド', tagColor: 'text-indigo-600 bg-indigo-50' },
      { href: '/articles/utm-windows-on-ios/', title: 'UTMで仮想化を活用', desc: 'iPadでWindowsやLinuxを動かす', tag: 'ガイド', tagColor: 'text-indigo-600 bg-indigo-50' },
    ],
  },
  {
    label: 'はじめかた',
    articles: [
      { href: '/articles/altstore-pal-guide/', title: 'AltStore PALの使い方', desc: 'Safariから無料でインストールできる代替ストアの使い方', tag: 'おすすめ', tagColor: 'text-indigo-600 bg-indigo-50' },
      { href: '/articles/install-app-step-by-step/', title: 'AltStore PALで始める ［最短ルート］', desc: 'PC不要・7日制限なし・無料で使える最新の導入手順', tag: '実践', tagColor: 'text-green-600 bg-green-50' },
      { href: '/articles/what-is-sideloading/', title: 'サイドローディングとは', desc: 'App Storeに頼らない新しいアプリの入手方法', tag: '入門', tagColor: 'text-blue-600 bg-blue-50' },
      { href: '/articles/how-to-use-altstore/', title: 'AltStore選び方ガイド', desc: 'PAL・Classic・SideStoreの違いを比較して最適な方法を選ぶ', tag: '入門', tagColor: 'text-blue-600 bg-blue-50' },
      { href: '/articles/altstore-complete-guide/', title: 'AltStore完全ガイド ［統合版］', desc: '基礎知識からトラブル対応まで全てを1ページにまとめた包括的ガイド', tag: '統合', tagColor: 'text-blue-600 bg-blue-50' },
    ],
  },
  {
    label: '安全性・法律',
    articles: [
      { href: '/articles/safety-guide/', title: '安全ガイド', desc: 'ウイルスから身を守る3つの鉄則', tag: '安全', tagColor: 'text-green-600 bg-green-50' },
      { href: '/articles/apple-notarization/', title: 'Apple公証とは', desc: 'サイドローディングが安全な仕組み', tag: '安全', tagColor: 'text-green-600 bg-green-50' },
      { href: '/articles/alternative-marketplace/', title: 'スマホ新法の代替アプリストア', desc: 'MSCA施行で解禁された代替アプリストア制度の解説', tag: '法律', tagColor: 'text-blue-600 bg-blue-50' },
      { href: '/articles/smartphone-law-explained/', title: 'スマホ新法解説', desc: 'iPhoneのアプリ配布が変わる理由', tag: '法律', tagColor: 'text-blue-600 bg-blue-50' },
      { href: '/articles/epic-games-store-japan/', title: 'Epic Games Store日本上陸', desc: 'スマホ新法が拓いた代替ストア第一号', tag: '法律', tagColor: 'text-blue-600 bg-blue-50' },
    ],
  },
  {
    label: '経済・支援',
    articles: [
      { href: '/articles/commission-cut/', title: '手数料30%カット', desc: 'アプリ価格は安くなるのか？', tag: '経済', tagColor: 'text-orange-600 bg-orange-50' },
      { href: '/articles/payment-freedom/', title: '決済の自由化', desc: 'App Store決済とWeb決済の使い分け', tag: '経済', tagColor: 'text-orange-600 bg-orange-50' },
      { href: '/articles/direct-support/', title: '直接支援', desc: 'お気に入りアプリの継続を支えるパトロン文化', tag: '支援', tagColor: 'text-pink-600 bg-pink-50' },
      { href: '/articles/our-policy/', title: '運営方針', desc: '当サイトが「公証済み」にこだわる理由', tag: '方針', tagColor: 'text-purple-600 bg-purple-50' },
    ],
  },
  {
    label: 'よくある質問',
    articles: [
      { href: '/articles/faq/', title: 'サイドローディングFAQ', desc: '不安とエラーへの回答集', tag: 'FAQ', tagColor: 'text-blue-600 bg-blue-50' },
    ],
  },
];
// BreadcrumbListスキーマ
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "ホーム", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "記事一覧", "item": `${siteUrl}/articles/` },
  ]
};

// ItemListスキーマ（全記事）
const allArticles = categories.flatMap(c => c.articles);
const articleListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "サイドローディング解説記事一覧",
  "numberOfItems": allArticles.length,
  "itemListElement": allArticles.map((article, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "name": article.title,
    "url": `${siteUrl}${article.href}`
  }))
};
---

<BaseLayout title="記事一覧" description="iPhoneサイドローディングの解説記事一覧。日本で無料の代替マーケットプレイス「AltStore PAL」の始め方、Delta・UTMガイド、安全性・著作権の法的情報まで。初心者向けガイドから上級者向けの技術解説まで20本以上を掲載。">
  <Fragment slot="schema">
    <Schema data={breadcrumbSchema} />
    <Schema data={articleListSchema} />
  </Fragment>

  <main class="max-w-6xl mx-auto px-4 py-6 sm:py-12">
    <div class="mb-6 sm:mb-8 pb-6 sm:pb-8 border-b-2 border-blue-200 relative overflow-hidden bg-gradient-to-br from-blue-50 via-white to-indigo-50 p-4 sm:p-8 rounded-xl">
      <h1 class="text-2xl sm:text-4xl font-bold mb-2 sm:mb-3 text-slate-800 flex items-center gap-2 sm:gap-3">
        <span class="material-symbols-outlined text-blue-500 text-[2rem] sm:text-[2.5rem]">library_books</span>
        記事一覧
      </h1>
      <p class="text-gray-600 text-base sm:text-lg">サイドローディングやアプリについての詳細解説</p>
      <p class="text-gray-600 text-sm sm:text-base mt-2 sm:mt-3 leading-relaxed">日本で無料で使える<strong class="text-indigo-600">AltStore PAL</strong>の始め方、サイドローディングの安全性と法的情報、エミュレータの著作権問題まで、初心者にもわかりやすく解説しています。いますぐ始めたい方は「<a href={`${base}articles/install-app-step-by-step/`} class="text-blue-600 underline font-medium">AltStore PALで始める</a>」、仕組みから知りたい方は「<a href={`${base}articles/what-is-sideloading/`} class="text-blue-600 underline font-medium">サイドローディングとは</a>」からどうぞ。</p>
    </div>

    <!-- 姉妹サイト案内バナー：レトロゲーム関連の記事は移転 -->
    <aside class="mb-8 sm:mb-12 p-4 sm:p-6 bg-gradient-to-br from-indigo-50 to-purple-50 border border-indigo-200 rounded-2xl">
      <h2 class="text-base sm:text-lg font-bold text-gray-900 mb-2 flex items-start gap-2">
        <span class="material-symbols-outlined text-indigo-500 flex-shrink-0" aria-hidden="true">sports_esports</span>
        レトロゲーム関連の記事は姉妹サイトへ
      </h2>
      <p class="text-sm sm:text-base text-gray-700 leading-relaxed mb-3 sm:mb-4">
        Deltaエミュレータ・GB Operator・著作権法第30条など、<strong>iPhoneでレトロゲームを合法的に楽しむ方法</strong>については、姉妹サイト <a href="https://retrogame.bunchoniki.com/" class="text-indigo-600 underline font-medium" target="_blank" rel="noopener">bunchoniki Retro</a> でより深く解説しています。
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-3">
        <a href="https://retrogame.bunchoniki.com/articles/delta-guide/" target="_blank" rel="noopener" class="block p-2 sm:p-3 bg-white rounded-lg border border-indigo-200 hover:border-indigo-400 transition-colors text-center">
          <span class="material-symbols-outlined text-indigo-500 text-base sm:text-xl block mb-1" aria-hidden="true">videogame_asset</span>
          <p class="text-xs sm:text-sm font-semibold text-gray-900">Delta完全ガイド</p>
        </a>
        <a href="https://retrogame.bunchoniki.com/articles/gb-operator-guide/" target="_blank" rel="noopener" class="block p-2 sm:p-3 bg-white rounded-lg border border-indigo-200 hover:border-indigo-400 transition-colors text-center">
          <span class="material-symbols-outlined text-indigo-500 text-base sm:text-xl block mb-1" aria-hidden="true">sd_card</span>
          <p class="text-xs sm:text-sm font-semibold text-gray-900">GB Operator</p>
        </a>
        <a href="https://retrogame.bunchoniki.com/articles/free-games-for-delta/" target="_blank" rel="noopener" class="block p-2 sm:p-3 bg-white rounded-lg border border-indigo-200 hover:border-indigo-400 transition-colors text-center">
          <span class="material-symbols-outlined text-indigo-500 text-base sm:text-xl block mb-1" aria-hidden="true">stadia_controller</span>
          <p class="text-xs sm:text-sm font-semibold text-gray-900">無料ゲーム特集</p>
        </a>
        <a href="https://retrogame.bunchoniki.com/articles/emulator-legal/" target="_blank" rel="noopener" class="block p-2 sm:p-3 bg-white rounded-lg border border-indigo-200 hover:border-indigo-400 transition-colors text-center">
          <span class="material-symbols-outlined text-indigo-500 text-base sm:text-xl block mb-1" aria-hidden="true">gavel</span>
          <p class="text-xs sm:text-sm font-semibold text-gray-900">エミュ著作権</p>
        </a>
      </div>
    </aside>

    {categories.map(category => (
      <section class="mb-8 sm:mb-16">
        <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-4 sm:mb-8 pb-2 sm:pb-3 border-b border-gray-200">{category.label}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
          {category.articles.map(article => (
            <a href={`${base}${article.href.slice(1)}`} class="group block h-full p-4 sm:p-6 bg-white rounded-2xl border border-gray-200 transition-[border-color,box-shadow,transform] duration-200 hover:shadow-lg hover:-translate-y-1">
              <h3 class="font-bold text-base sm:text-lg text-gray-900 mb-1.5 sm:mb-2 group-hover:text-blue-600 transition-colors">{article.title}</h3>
              <p class="text-sm text-gray-600 mb-3 sm:mb-4 line-clamp-2">{article.desc}</p>
              <span class={`inline-block px-3 py-1 text-xs font-medium rounded-full ${article.tagColor}`}>{article.tag}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>
</BaseLayout>
